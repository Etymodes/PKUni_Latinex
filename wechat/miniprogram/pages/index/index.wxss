/* pages/index/index.wxss */
/* Target Arabic runs RTL; navigation and the selected display language stay LTR. */
.target-rtl { direction: rtl; unicode-bidi: plaintext; text-align: right; }

.support-feedback { display: flex; align-items: stretch; gap: 16rpx; margin: 24rpx 0 12rpx; }
.support-feedback button { flex: 1; min-width: 0; margin: 0; min-height: 96rpx; display: flex; align-items: center; justify-content: center; line-height: 1.35; }

.study-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 16px 0; }
.shell .study-grid button { width: 100%; margin: 0; min-height: 48px; white-space: normal; line-height: 1.4; }
.community-compose { width: 100%; min-height: 80px; box-sizing: border-box; padding: 12px; background: #faf7f1; border-radius: 12px; }
.community-message .body { white-space: pre-wrap; overflow-wrap: anywhere; }
.community-translation { border-top: 1px solid #e1d8ca; padding-top: 12px; color: #665c50; }
