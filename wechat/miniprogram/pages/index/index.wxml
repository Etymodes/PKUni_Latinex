<template name="word-details">
  <text wx:if="{{details.otherSpellings}}" class="body">{{t.otherSpellings}} · {{details.otherSpellings}}</text>
  <text wx:if="{{details.additionalReading}}" class="body">{{details.additionalReading}}</text>
  <text wx:if="{{details.otherReadings}}" class="body">{{t.otherReadings}} · {{details.otherReadings}}</text>
  <text wx:if="{{details.additionalMeaning}}" class="body">{{t.additionalMeaning}} · {{details.additionalMeaning}}</text>
  <text wx:if="{{details.usageNotes}}" class="body">{{details.usageNotes}}</text>
  <text wx:for="{{details.senses}}" wx:key="index" class="body">{{item.reading}} · {{item.gloss}}</text>
  <view wx:for="{{details.dictionaryReferences}}" wx:key="url" class="body"><button class="text-button" data-url="{{item.url}}" bindtap="copyResource">{{item.name}} ↗</button><text>{{item.note}}</text></view>
</template>
<view class="shell">
  <view class="brand-row">
    <image class="logo" src="/assets/logo.png" mode="aspectFit" />
    <view class="brand"><text class="brand-title">哔丘 Pikku</text><text class="eyebrow">COTĪDIĒ PAULUM</text></view>
    <button class="locale {{locale === 'en' ? 'locale-en' : ''}}" bindtap="changeLocale" disabled="{{busy}}" aria-label="{{t.localeAction}}"><text class="locale-mark">{{locale === 'en' ? '⇋语' : '语⇌'}}</text><text class="locale-word">Language</text></button>
  </view>
  <view class="status {{sync === 'failed' ? 'status-error' : ''}}"><text class="dot">●</text> {{t[sync]}}</view>
  <view wx:if="{{error}}" class="notice" role="alert">{{error}}<button class="text-button" bindtap="refresh" disabled="{{busy}}">{{t.refresh}}</button></view>

  <block wx:if="{{view !== 'account' && view !== 'resources'}}">
    <picker mode="selector" range="{{languages}}" range-key="label" value="{{languageIndex}}" bindchange="changeLanguage" disabled="{{busy}}">
      <view class="language-picker"><text class="muted">{{t.learning}}</text><text>{{languageLabel}}⌄</text></view>
    </picker>
    <level-selector wx:if="{{view !== 'dictionary' && view !== 'review' && view !== 'community'}}" value="{{level}}" locale="{{locale}}" disabled="{{busy}}" bindchange="changeLevel" />
  </block>

  <block wx:if="{{view === 'home'}}">
    <view class="hero panel">
      <text class="eyebrow">{{greeting}}</text><text class="hero-title">{{t.title}}</text><text class="body muted">{{t.subtitle}}</text>
      <button class="primary" data-view="practiceHub" bindtap="changeView" disabled="{{busy}}">{{t.start}} →</button>
    </view>
    <button class="row-link story-entry" data-view="story" bindtap="changeView">{{t.story}} <text>{{t.comingSoon}} →</text></button>
    <view class="stats">
      <view><text class="number">{{stats.answered}}</text><text>{{t.answered}}</text></view>
      <view><text class="number">{{stats.correct}}</text><text>{{t.correct}}</text></view>
      <view><text class="number">{{stats.bookmarks}}</text><text>{{t.bookmarked}}</text></view>
      <view><text class="number">{{stats.words}}</text><text>{{t.wordSeen}}</text></view>
    </view>
    <view class="fact"><text class="eyebrow">LINGUA · {{languageLabel}}</text><text class="fact-title {{language === 'ar' ? 'target-rtl' : ''}}">{{factStatement}}</text><text class="body">{{factMeaning}}</text></view>
    <view wx:if="{{isSeed}}" class="note">{{t.seedNote}}</view>
    <text class="note">{{t.contentNote}}</text>
  </block>

  <block wx:if="{{view === 'practiceHub'}}">
    <text class="section-title">{{t.practice}} · {{languageLabel}}</text>
    <view class="study-grid"><button class="secondary" data-view="courses" bindtap="changeView">{{t.courses}}</button><button class="secondary" bindtap="openOrderedPractice">{{t.orderedPractice}}</button><button class="secondary" data-view="review" bindtap="changeView">{{t.reviewCenter}}</button><button class="secondary" data-view="exam" bindtap="changeView">{{t.randomExam}}</button><button class="secondary" data-view="words" bindtap="changeView">{{t.words}}</button></view>
    <button wx:if="{{paperItems.length}}" class="secondary question-bank" bindtap="openQuestionBank" disabled="{{busy}}">{{t.questionBank}} →</button>
  </block>
  <block wx:if="{{view === 'review'}}"><text class="section-title">{{t.reviewCenter}} · {{languageLabel}}</text><text class="note">{{t.reviewAcrossLevels}}</text><button class="row-link" data-filter="wrong" bindtap="openReview">{{t.wrong}} <text>{{reviewWrongCount}} →</text></button><button class="row-link" data-filter="saved" bindtap="openReview">{{t.saved}} <text>{{reviewSavedCount}} →</text></button></block>

  <block wx:if="{{view === 'courses'}}">
    <text class="section-title">{{t.courses}} · {{languageLabel}}</text><text class="note">{{t.courseNote}}</text>
    <view wx:for="{{courseLevels}}" wx:key="level" class="panel"><text class="section-title">{{item.level}}</text><text class="body">{{item.questions}} {{t.results}} · {{item.words}} {{t.entries}}</text><button class="primary" data-level="{{item.level}}" bindtap="openCourseLevel" disabled="{{busy || !item.questions}}">{{t.orderedPractice}}</button></view>
  </block>
  <block wx:if="{{view === 'story'}}"><view class="panel empty"><text class="section-title">{{t.story}} · {{t.comingSoon}}</text><text class="body">{{t.storySoon}}</text></view></block>
  <block wx:if="{{view === 'exam'}}">
    <text class="section-title">{{t.randomExam}} · {{languageLabel}}</text><text class="note">{{t.examNote}}</text>
    <view class="language-picker"><text>{{t.mixedLevels}}</text><switch checked="{{examMixed}}" bindchange="changeExamMixed" /></view>
    <view wx:if="{{examFinished}}" class="panel"><text class="section-title">{{t.examResult}}</text><text class="body">{{t.examAnswered}} {{examAnswered}} / {{examTotal}} · {{t.examCorrect}} {{examCorrect}}</text></view>
    <text wx:if="{{examEmpty}}" class="note">{{t.empty}}</text><button class="primary" bindtap="startExam" disabled="{{busy}}">{{t.startExam}}</button>
  </block>
  <block wx:if="{{view === 'measurement'}}">
    <text class="section-title">{{t.measurement}} · {{languageLabel}}</text><text class="note">{{t.measurementNote}}</text>
    <block wx:if="{{measurementItems.length && !measurementDone}}">
      <view wx:if="{{!measurementReady}}" class="panel"><text class="eyebrow">{{measurementIndex + 1}} / {{measurementTotal}}</text><text class="word-term {{language === 'ar' ? 'target-rtl' : ''}}">{{measurementItem.lemma}}</text><button wx:for="{{measurementItem.options}}" wx:key="index" class="option" data-index="{{item.index}}" bindtap="answerMeasurement" disabled="{{busy}}">{{item.text}}</button></view>
      <view wx:else class="panel"><text class="body">{{t.measurementReady}}</text><button class="primary" bindtap="finishMeasurement" disabled="{{busy}}">{{t.submitMeasurement}}</button></view>
    </block>
    <block wx:else><view wx:if="{{measurementDone}}" class="panel"><text class="body">{{t.measurementScore}} {{measurementScore}} / {{measurementTotal}}</text><text class="body">{{t.measurementEstimate}} {{measurementEstimate}} / {{measurementPool}}</text></view><text wx:if="{{measurementEmpty}}" class="note">{{t.emptyWords}}</text><button class="primary" bindtap="startMeasurement" disabled="{{busy}}">{{t.startMeasurement}}</button></block>
  </block>
  <block wx:if="{{view === 'community'}}">
    <text class="section-title">{{t.community}} · {{languageLabel}}</text>
    <block wx:if="{{communityEnabled}}">
      <view class="filters"><button class="chip {{communityChannel === 'language' ? 'chosen' : ''}}" data-channel="language" bindtap="changeCommunityChannel">{{t.communityLanguage}}</button><button class="chip {{communityChannel === 'study' ? 'chosen' : ''}}" data-channel="study" bindtap="changeCommunityChannel">{{t.communityStudy}}</button></view>
      <text class="note">{{t.communityRule}}</text><text wx:if="{{communityWarnings}}" class="note">{{t.communityWarnings}} {{communityWarnings}} / 4</text>
      <text wx:if="{{communityMuted}}" class="notice">{{t.communityMutedUntil}} {{communityMuteLabel}}</text><text wx:if="{{communityAiAvailable === false && !communityLoading}}" class="note">{{t.communityNoAI}}</text>
      <view wx:if="{{communityError}}" class="notice" role="alert">{{communityError}}</view><button class="text-button" bindtap="loadCommunity" loading="{{communityLoading}}">{{t.communityRefresh}}</button>
      <view wx:if="{{!communityItems.length && !communityLoading && !communityError}}" class="panel empty">{{t.communityEmpty}}</view>
      <view wx:for="{{communityItems}}" wx:key="id" class="panel community-message"><view class="community-author"><text class="message-avatar" aria-label="{{t.avatar}}">{{item.avatarText}}</text><text class="eyebrow">{{item.authorName}}</text></view><text class="body" user-select="true">{{item.text}}</text><text wx:if="{{item.translation}}" class="body community-translation">{{item.translation}}</text><view wx:if="{{user}}" class="actions"><button wx:if="{{!item.mine}}" class="text-button" data-id="{{item.id}}" bindtap="translateCommunity" disabled="{{!!communityTranslating}}">{{t.communityTranslate}}</button><button class="text-button" data-id="{{item.id}}" data-action="{{item.mine ? 'delete' : 'report'}}" bindtap="moderateCommunity">{{item.mine ? t.communityDelete : t.communityReport}}</button></view></view>
      <view wx:if="{{user}}" class="panel"><textarea class="community-compose" maxlength="1000" value="{{communityDraft}}" placeholder="{{t.communityMessage}}" bindinput="inputCommunity" disabled="{{communitySending || communityMuted}}" auto-height="{{true}}" /><button class="primary" bindtap="sendCommunity" loading="{{communitySending}}" disabled="{{communitySending || communityMuted || !communityDraft}}">{{t.communitySend}}</button></view>
      <view wx:else class="panel"><text class="body">{{t.communitySignIn}}</text><button class="primary" data-view="account" bindtap="changeView">{{t.signIn}}</button></view>
    </block><view wx:else class="panel empty">{{t.communitySoon}}</view>
  </block>

  <block wx:if="{{view === 'papers'}}">
    <text class="section-title">{{t.questionBank}}</text>
    <input class="search" placeholder="{{t.searchPapers}}" value="{{paperSearch}}" bindinput="searchPapers" maxlength="100" disabled="{{busy}}" />
    <text class="note">{{matchingPapers.length}} {{t.paperCollections}}</text>
    <block wx:if="{{matchingPapers.length}}">
      <picker mode="selector" range="{{matchingPapers}}" range-key="label" value="{{bankPaperIndex}}" bindchange="selectPaper" disabled="{{busy}}"><view class="language-picker">{{matchingPapers[bankPaperIndex].label}}⌄</view></picker>
      <button class="primary" data-collection="{{matchingPapers[bankPaperIndex].id}}" bindtap="openPaper" disabled="{{busy}}">{{t.openPaper}} →</button>
    </block>
    <view wx:else class="panel empty">{{t.emptyPapers}}</view>
  </block>

  <block wx:if="{{view === 'practice'}}">
    <view wx:if="{{examActive}}" class="language-picker"><text>{{t.randomExam}} · {{examTime}}</text><button class="text-button" bindtap="finishExam">{{t.finishExam}}</button></view>
    <block wx:if="{{!examActive}}">
    <text wx:if="{{reviewScope}}" class="note">{{t.reviewAcrossLevels}}</text>
    <view wx:if="{{paperItems.length && !reviewScope}}" class="panel paper-selector">
      <button class="text-button" bindtap="openQuestionBank" disabled="{{busy}}">{{t.questionBank}} →</button>
      <picker mode="selector" range="{{paperItems}}" range-key="label" value="{{selectedPaperIndex}}" bindchange="changePaper" disabled="{{busy}}"><view class="language-picker">{{paperItems[selectedPaperIndex].label}}⌄</view></picker>
      <view class="filters"><button class="chip" bindtap="openPaper" disabled="{{busy}}">{{t.paperAll}}</button><button class="chip" data-category="vocabulary" bindtap="openPaper" disabled="{{busy}}">{{t.paperVocabulary}}</button><button wx:if="{{paperHasMedia}}" class="chip" data-category="listening" bindtap="openPaper" disabled="{{busy}}">{{t.categories.listening}}</button><button wx:if="{{paperHasMedia}}" class="chip" data-category="reading" bindtap="openPaper" disabled="{{busy}}">{{t.categories.reading}}</button><button class="chip" data-category="sentencePattern" bindtap="openPaper" disabled="{{busy}}">{{t.paperGrammar}}</button></view>
      <block wx:if="{{fullPaper}}"><text class="note">{{t.fullPaper}}</text><button class="text-button" bindtap="exitPaper" disabled="{{busy}}">{{t.exitPaper}}</button><picker wx:if="{{paperQuestions.length}}" mode="selector" range="{{paperQuestions}}" range-key="label" value="{{paperQuestionIndex}}" bindchange="jumpQuestion" disabled="{{busy}}"><view class="language-picker">{{t.originalNumber}} · {{paperQuestions[paperQuestionIndex].label}}⌄</view></picker></block>
    </view>
    <view class="filters">
      <button wx:if="{{!reviewScope}}" class="chip {{filter === 'all' ? 'chosen' : ''}}" data-filter="all" bindtap="changeFilter" disabled="{{busy}}">{{t.all}}</button>
      <button class="chip {{filter === 'wrong' ? 'chosen' : ''}}" data-filter="wrong" bindtap="changeFilter" disabled="{{busy}}">{{t.wrong}}</button>
      <button class="chip {{filter === 'saved' ? 'chosen' : ''}}" data-filter="saved" bindtap="changeFilter" disabled="{{busy}}">{{t.saved}}</button>
    </view>
    </block>
    <block wx:if="{{!question}}">
      <picker mode="selector" range="{{categoryItems}}" range-key="label" value="{{categoryIndex}}" bindchange="changeCategory" disabled="{{busy}}"><view class="language-picker">{{t.categories[category]}}⌄ <text class="muted">{{resultCount}} {{t.results}}</text></view></picker>
      <input class="search" placeholder="{{t.search}}" value="{{search}}" bindinput="changeSearch" maxlength="100" disabled="{{busy}}" />
      <button wx:if="{{resultCount}}" class="primary" bindtap="startPractice" disabled="{{busy}}">{{t.start}} →</button>
      <view wx:else class="panel empty">{{t.empty}}</view>
      <button wx:if="{{resultCount}}" class="secondary" bindtap="startOrderedPractice" disabled="{{busy}}">{{t.orderedStart}}</button>
      <button wx:if="{{resultCount}}" class="text-button" bindtap="toggleBrowse">{{t.browse}}⌄</button>
      <view wx:if="{{browse}}" class="question-list">
        <button wx:for="{{results}}" wx:key="id" class="question-link" data-id="{{item.id}}" bindtap="openQuestion" disabled="{{busy}}"><text>{{item.prompt}}</text><text class="muted">{{item.id}} {{item.status === 'correct' ? '✓' : ''}}</text></button>
      </view>
      <button wx:if="{{browse && results.length < resultCount}}" class="text-button" bindtap="moreQuestions">{{t.moreQuestions}}</button>
    </block>
    <view wx:else class="panel question-panel">
      <view class="question-top"><text class="eyebrow">{{questionIndex + 1}} / {{questionTotal}} · {{t.categories[question.category]}}</text><button class="text-button" bindtap="toggleBookmark" disabled="{{busy}}">{{isBookmarked ? '★ ' + t.unbookmark : '☆ ' + t.bookmark}}</button></view>
      <text wx:if="{{question.originalNumber}}" class="note">{{t.originalNumber}} · {{question.originalNumber}} · {{question.level}}</text>
      <text class="question-title">{{question.prompt}}</text>
      <text wx:if="{{question.passage}}" class="target-text question-passage {{language === 'ar' ? 'target-rtl' : ''}}" user-select="true">{{question.passage}}</text>
      <text wx:if="{{question.targetText || question.text || question.latin}}" class="target-text {{language === 'ar' ? 'target-rtl' : ''}}" user-select="true">{{question.targetText || question.text || question.latin}}</text>
      <text wx:if="{{question.context}}" class="body muted">{{question.context}}</text>
      <view wx:for="{{questionImages}}" wx:key="src" class="question-image"><image src="{{item.src}}" mode="widthFix" style="width:100%;" data-index="{{index}}" bindtap="previewQuestionImage" aria-label="{{item.alt || t.questionImage}}" /><text class="note">{{item.alt}}</text></view>
      <view wx:if="{{questionAudioSource}}" class="question-audio"><view class="actions"><button class="secondary" bindtap="toggleQuestionAudio">{{audioPlaying ? t.pauseAudio : t.playAudio}}</button><button class="text-button" bindtap="restartQuestionAudio">{{t.restartAudio}}</button></view><slider min="0" max="{{audioDuration || 1}}" step="1" value="{{audioCurrent}}" disabled="{{!audioDuration}}" bindchange="seekQuestionAudio" aria-label="{{t.playAudio}}" /><text class="note">{{audioTime}} / {{audioTotal}}</text><text wx:if="{{audioError}}" class="notice" role="alert">{{audioError}}</text></view>
      <text wx:if="{{question.optionsInAudio}}" class="note">{{t.optionsInAudio}}</text>
      <view wx:if="{{question.type === 'choice'}}" class="options">
        <button wx:for="{{choices}}" wx:key="index" class="option {{submitted && item.index === question.answer ? 'answer-right' : ''}} {{submitted && item.index === selected && !answerCorrect ? 'answer-wrong' : ''}}" data-index="{{item.index}}" bindtap="answer" disabled="{{busy || submitted}}"><text class="option-number">{{index + 1}}</text><text class="{{item.rtl ? 'target-rtl' : ''}}" wx:if="{{!question.optionsInAudio || submitted}}">{{item.text}}</text></button>
      </view>
      <button wx:elif="{{!revealed}}" class="secondary" bindtap="revealAnswer">{{t.reveal}}</button>
      <block wx:if="{{revealed}}">
        <view class="answer-panel"><text class="answer-title">{{submitted ? (answerCorrect ? t.right : t.mistake) : t.reveal}}</text><text wx:if="{{question.modelAnswer}}" class="body">{{question.modelAnswer}}</text><text class="body">{{question.explanation}}</text></view>
        <view wx:if="{{question.type === 'self-check' && !submitted}}" class="actions"><button class="secondary" data-correct="no" bindtap="answer" disabled="{{busy}}">{{t.selfWrong}}</button><button class="primary" data-correct="yes" bindtap="answer" disabled="{{busy}}">{{t.selfCorrect}}</button></view>
      </block>
      <view wx:if="{{submitted && visibleTranscript}}" class="answer-panel question-transcript"><button class="text-button" bindtap="toggleTranscript">{{t.transcript}} {{transcriptOpen ? '▴' : '▾'}}</button><text wx:if="{{transcriptOpen}}" class="target-text {{language === 'ar' ? 'target-rtl' : ''}}" user-select="true">{{visibleTranscript}}</text></view>
      <view wx:if="{{question.occurrences.length}}" class="filters"><text wx:for="{{question.occurrences}}" wx:key="sourceQuestionId" class="chip">{{item.label}} · {{item.originalNumber}}</text></view>
      <view class="source">{{t.source}} · {{question.source}}<text wx:if="{{question.reviewStatus}}"> · {{t[question.reviewStatus]}}</text></view>
      <button class="primary" bindtap="nextQuestion" disabled="{{busy}}">{{t.next}} →</button>
    </view>
  </block>

  <block wx:if="{{view === 'words'}}">
    <view class="language-picker"><text class="muted">{{t.wordMode}}</text><button class="text-button" bindtap="changeWordMode" disabled="{{busy}}">{{t[vocabMode]}} ⇄</button></view>
    <text class="note">{{t.levelVocabulary}} · {{eligibleWords}} {{t.entries}}</text>
    <input class="search" placeholder="{{t.wordSearch}}" value="{{wordQuery}}" bindinput="changeWordQuery" maxlength="100" disabled="{{busy}}" />
    <button class="row-link" bindtap="openDictionary" disabled="{{busy}}">{{t.dictionary}} <text>→</text></button>
    <text class="note">{{t.thisRound}} {{roundTotal || 0}} · {{t.remember}} {{roundRemembered || 0}} · {{t.approximate}} {{roundApproximate || 0}}</text>
    <view wx:if="{{pendingWords}}" class="notice">{{pendingWords}} {{t.pendingWords}}<button class="text-button" bindtap="refresh" disabled="{{busy}}">{{t.refresh}}</button></view>
    <view wx:if="{{card}}" class="panel word-panel">
      <text wx:if="{{focusedWord}}" class="note">{{t.focusedWord}}</text>
      <text class="eyebrow">{{card.level || t.ungraded}} · {{vocabMode === 'context' && card.context ? t.context : t.word}}</text>
      <text class="word-term {{language === 'ar' ? 'target-rtl' : ''}}" user-select="true">{{card.term}}</text>
      <text wx:if="{{vocabMode === 'context' && card.context}}" class="word-context {{language === 'ar' ? 'target-rtl' : ''}}">{{card.context}}</text>
      <button wx:if="{{!wordRevealed}}" class="secondary" bindtap="revealWord" disabled="{{busy}}">{{t.revealWord}}</button>
      <block wx:else>
        <text wx:if="{{card.reading}}" class="body">{{card.reading}}</text><text class="word-meaning">{{card.meaning}}</text><text class="note">{{card.partOfSpeech}}</text>
        <template is="word-details" data="{{details: wordDetails, t}}" />
        <view class="actions word-feedback"><button class="secondary" data-outcome="forgotten" bindtap="rateWord" disabled="{{busy}}">{{t.forget}}</button><button class="approximate-button" data-outcome="approximate" bindtap="rateWord" disabled="{{busy}}">≈ {{t.approximate}}</button><button class="primary" data-outcome="remembered" bindtap="rateWord" disabled="{{busy}}">{{t.remember}}</button></view>
        <text class="note">{{t.approximateHelp}}</text>
        <view class="forecast">
          <picker mode="date" value="{{forecastDate}}" start="{{today}}" bindchange="changeForecastDate"><view class="language-picker">{{t.forecastDate}} <text>{{forecastDate}}⌄</text></view></picker>
          <block wx:if="{{future}}"><text class="body">{{t.predicted}} · {{t.outcomes[future.outcome]}}</text><text class="note">{{t.forget}} {{future.forgotten}}% · {{t.approximate}} {{future.approximate}}% · {{t.remember}} {{future.remembered}}%</text><text wx:if="{{!future.hasTimedHistory}}" class="note">{{t.noTimedHistory}}</text></block>
          <text class="note">{{t.forecastNote}}</text>
        </view>
      </block>
    </view>
    <view wx:else class="panel empty">{{t.emptyWords}}</view>
    <button class="row-link" bindtap="toggleModel">{{t.learningModel}} <text>⌄</text></button>
    <view wx:if="{{showModel}}" class="panel"><text class="body">{{t.modelNote}}</text><text class="body">{{t.modelSamples}} {{modelSamples}}</text><text wx:if="{{modelError !== ''}}" class="note">{{t.modelError}} {{modelError}} · {{modelCount}} {{t.entries}} · {{t.modelBaseline}} {{modelBaseline}}</text><button class="secondary" bindtap="exportWordReviews" disabled="{{!modelSamples}}">{{t.exportReviews}}</button></view>
  </block>

  <block wx:if="{{view === 'dictionary'}}">
    <text class="section-title">{{t.dictionary}} · {{languageLabel}}</text>
    <block wx:if="{{!dictionaryDetail}}">
      <text class="note">{{t.dictionaryNote}}</text><input class="search" placeholder="{{t.dictionaryBrowse}}" value="{{dictionaryQuery}}" bindinput="searchDictionary" maxlength="100" />
      <view class="dictionary-filters"><picker mode="selector" range="{{dictionaryFields}}" range-key="label" value="{{dictionaryFieldIndex}}" data-filter="field" bindchange="changeDictionaryFilter"><view class="dictionary-filter">{{dictionaryFields[dictionaryFieldIndex].label}}⌄</view></picker><picker mode="selector" range="{{dictionaryOrders}}" range-key="label" value="{{dictionaryOrderIndex}}" data-filter="order" bindchange="changeDictionaryFilter"><view class="dictionary-filter">{{dictionaryOrders[dictionaryOrderIndex].label}}⌄</view></picker><picker mode="selector" range="{{dictionaryIndices}}" range-key="label" value="{{dictionaryIndexIndex}}" data-filter="index" bindchange="changeDictionaryFilter"><view class="dictionary-filter">{{dictionaryIndices[dictionaryIndexIndex].label}}⌄</view></picker><picker mode="selector" range="{{dictionaryLevels}}" range-key="label" value="{{dictionaryLevelIndex}}" data-filter="level" bindchange="changeDictionaryFilter"><view class="dictionary-filter">{{dictionaryLevels[dictionaryLevelIndex].label}}⌄</view></picker><picker mode="selector" range="{{dictionaryParts}}" range-key="label" value="{{dictionaryPartIndex}}" data-filter="part" bindchange="changeDictionaryFilter"><view class="dictionary-filter">{{dictionaryParts[dictionaryPartIndex].label}}⌄</view></picker></view><text class="note">{{dictionaryTotal}} / {{dictionaryCount}} {{t.entries}}</text>
      <view class="dictionary-list"><button wx:for="{{dictionaryRows}}" wx:key="id" class="dictionary-result" data-id="{{item.id}}" bindtap="openDictionaryEntry"><view class="dictionary-result-heading"><text class="dictionary-term {{language === 'ar' ? 'target-rtl' : ''}}">{{item.card.term}}</text><text class="muted">{{item.card.level}} →</text></view><text wx:if="{{item.card.reading}}" class="dictionary-reading">{{item.card.reading}}</text><text class="dictionary-summary">{{item.card.meaning}}</text></button></view>
      <view wx:if="{{dictionaryTotal}}" class="actions"><button class="secondary" bindtap="previousDictionary" disabled="{{!dictionaryOffset}}">{{t.previousEntries}}</button><button class="secondary" bindtap="moreDictionary" disabled="{{dictionaryLast >= dictionaryTotal}}">{{t.nextEntries}}</button></view><text wx:if="{{dictionaryTotal}}" class="note">{{dictionaryFirst}}–{{dictionaryLast}} / {{dictionaryTotal}}</text><view wx:if="{{!dictionaryTotal}}" class="panel empty">{{t.emptyDictionary}}</view>
    </block>
    <block wx:else><button class="text-button" bindtap="closeDictionaryEntry">← {{t.dictionaryBack}}</button><view class="panel dictionary-detail">
      <text class="word-term {{language === 'ar' ? 'target-rtl' : ''}}">{{dictionaryDetail.term}}</text><text wx:if="{{dictionaryDetail.reading}}" class="body">{{dictionaryDetail.reading}}</text><text class="note">{{dictionaryDetail.level}} · {{dictionaryDetail.partOfSpeech}}</text>
      <view wx:if="{{dictionaryDetail.spellings.length}}" class="body"><text>{{t.otherSpellings}} · </text><text wx:for="{{dictionaryDetail.spellings}}" wx:key="*this">{{item}} </text></view><view wx:if="{{dictionaryDetail.readings.length}}" class="body"><text>{{t.otherReadings}} · </text><text wx:for="{{dictionaryDetail.readings}}" wx:key="*this">{{item}} </text></view>
      <text wx:if="{{dictionaryDetail.usageNotes}}" class="body">{{dictionaryDetail.usageNotes}}</text>
      <text class="resource-title">{{t.dictionarySenses}}</text><view wx:for="{{dictionaryDetail.senses}}" wx:key="number" class="dictionary-sense"><text class="body"><text class="sense-number">{{item.number}}.</text> {{item.gloss}}</text><text wx:if="{{item.reading || item.partOfSpeech}}" class="note">{{item.reading}} {{item.partOfSpeech}}</text><button wx:if="{{item.source}}" class="text-button citation-link" data-url="{{item.source.url}}" bindtap="copyResource">{{t.citation}} · {{item.source.name}} ↗</button></view>
      <block wx:if="{{dictionaryDetail.examples.length}}"><text class="resource-title">{{t.dictionaryExamples}}</text><view wx:for="{{dictionaryDetail.examples}}" wx:key="text" class="dictionary-example"><text class="target-text {{language === 'ar' ? 'target-rtl' : ''}}" user-select="true">{{item.text}}</text><text wx:if="{{item.translation}}" class="body">{{item.translation}}</text><text wx:if="{{item.editorial}}" class="note">{{t.learningExample}}</text><button wx:if="{{item.source}}" class="text-button citation-link" data-url="{{item.source.url}}" bindtap="copyResource">{{t.citation}} · {{item.source.name}} ↗</button></view></block>
      <block wx:if="{{dictionaryDetail.etymology.length}}"><text class="resource-title">{{t.dictionaryEtymology}}</text><view wx:for="{{dictionaryDetail.etymology}}" wx:key="text"><text class="body">{{item.text}}</text><button class="text-button citation-link" data-url="{{item.source.url}}" bindtap="copyResource">{{item.source.name}} ↗</button></view></block>
      <block wx:if="{{dictionaryDetail.references.length}}"><text class="resource-title">{{t.dictionaryReferences}}</text><view wx:for="{{dictionaryDetail.references}}" wx:key="key" class="dictionary-reference"><button class="text-button citation-link" data-url="{{item.url}}" bindtap="copyResource">{{item.name}} ↗</button><text wx:if="{{item.note}}" class="note">{{item.note}}</text><button wx:if="{{item.licenseUrl}}" class="text-button citation-link" data-url="{{item.licenseUrl}}" bindtap="copyResource">{{t.dictionaryLicense}} · {{item.license}}</button><text wx:elif="{{item.license}}" class="note">{{item.license}}</text></view></block>
      <text class="note">{{t.reviewedWords}} {{dictionaryDetail.stat.seen}} · {{t.remember}} {{dictionaryDetail.stat.correct}} · {{t.approximate}} {{dictionaryDetail.stat.approximate}}</text><button class="primary" data-id="{{dictionaryDetail.id}}" bindtap="practiseWord" disabled="{{busy}}">{{t.practiseWord}}</button>
    </view></block>
  </block>

  <block wx:if="{{view === 'resources'}}">
    <text class="section-title">{{t.resources}} · {{languageLabel}}</text><text class="note">{{t.resourceNote}}</text>
    <view wx:if="{{!textbooks.length && !dictionaries.length}}" class="panel empty">{{t.noResources}}</view>
    <view wx:for="{{textbooks}}" wx:key="id" class="panel resource"><text class="resource-title">{{item.title}}</text><text class="body">{{item.authors}} · {{item.edition}}</text><text class="note">{{item.accessNote}}</text></view>
    <view wx:for="{{dictionaries}}" wx:key="id" class="panel resource"><text class="resource-title">{{item.name}}</text><text class="body">{{item.scope}}</text><text class="note">{{item.access}}</text></view>
  </block>

  <block wx:if="{{view === 'account'}}">
    <text class="section-title">{{t.account}}</text>
    <button class="row-link" data-view="dictionary" bindtap="changeView">{{t.dictionary}} <text>→</text></button><button class="row-link" data-view="measurement" bindtap="changeView">{{t.measurement}} <text>→</text></button><button class="row-link" data-view="resources" bindtap="changeView">{{t.resources}} <text>→</text></button>
    <view class="panel account-panel">
      <text class="body">{{t.accountIntro}}</text>
      <block wx:if="{{user}}"><text class="account-email">{{user.email}}</text><button class="primary" bindtap="refresh" loading="{{busy}}" disabled="{{busy}}">{{t.refresh}}</button><button class="text-button" bindtap="signOut" disabled="{{busy}}">{{t.signOut}}</button></block>
      <block wx:else><input class="field" type="text" value="{{email}}" placeholder="{{t.email}}" bindinput="inputEmail" maxlength="254" disabled="{{busy}}" /><input class="field" password="true" value="{{password}}" placeholder="{{t.password}}" bindinput="inputPassword" maxlength="256" bindconfirm="signIn" disabled="{{busy}}" /><button class="primary" bindtap="signIn" loading="{{busy}}" disabled="{{busy}}">{{t.signIn}}</button><text class="note">{{t.websiteHelp}}</text><button class="text-button" bindtap="copyWebsite">{{t.register}} ↗</button></block>
      <text class="note">{{t.accountNote}}</text>
    </view>
    <view class="panel avatar-settings"><text class="resource-title">{{t.avatar}}</text><view class="avatar-preview">{{avatarPreview}}</view><text wx:if="{{!user}}" class="note">{{t.avatarLogin}}</text><block wx:else><view class="filters"><button class="chip {{avatarKind === 'initials' ? 'chosen' : ''}}" data-kind="initials" bindtap="changeAvatarKind" disabled="{{profileSaving || profileExpired}}">{{t.avatarInitials}}</button><button class="chip {{avatarKind === 'preset' ? 'chosen' : ''}}" data-kind="preset" bindtap="changeAvatarKind" disabled="{{profileSaving || profileExpired}}">{{t.avatarPresetsLabel}}</button></view><input wx:if="{{avatarKind === 'initials'}}" class="field avatar-input" maxlength="3" value="{{avatarValue}}" bindinput="inputAvatar" disabled="{{profileSaving || profileExpired}}" placeholder="A / AB / Ab / Abc" /><view wx:else class="avatar-grid"><button wx:for="{{avatarPresets}}" wx:key="id" class="avatar-preset {{avatarValue === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="selectAvatarPreset" aria-label="{{item.label}}" disabled="{{profileSaving || profileExpired}}">{{item.emoji}}</button></view><text class="note">{{t.avatarFormat}}</text><text wx:if="{{!avatarValid}}" class="notice">{{t.avatarInvalid}}</text><text wx:if="{{profileError}}" class="notice" role="alert">{{profileError}}</text><text wx:if="{{profileSaved}}" class="note">{{t.avatarSaved}}</text><button class="primary" bindtap="saveAvatar" loading="{{profileSaving}}" disabled="{{profileExpired || profileSaving || profileLoading || !avatarValid || !avatarDirty}}">{{t.avatarSave}}</button><button wx:if="{{profileExpired}}" class="text-button" bindtap="refresh">{{t.refresh}}</button><button wx:else class="text-button" bindtap="loadProfile" loading="{{profileLoading}}" disabled="{{profileSaving || profileLoading}}">{{t.avatarRetry}}</button></block></view>
    <button class="locale locale-setting {{locale === 'en' ? 'locale-en' : ''}}" bindtap="changeLocale" disabled="{{busy}}" aria-label="{{t.localeAction}}"><text class="locale-mark">{{locale === 'en' ? '⇋语' : '语⇌'}}</text><text class="locale-word">Language</text></button>
    <view class="support-feedback"><button class="secondary" bindtap="toggleSupport">{{t.supportAuthor}}</button><button class="secondary feedback-link" data-url="https://docs.qq.com/sheet/DQ3h3YWt0cE5IS1pG" bindtap="copyResource">{{t.feedback}}</button></view>
    <text class="note">{{t.feedbackHelp}}</text>
    <view wx:if="{{showSupport}}" class="panel support-panel"><text class="resource-title">{{t.supportAuthor}}</text><text class="note">{{t.supportNote}}</text><image class="support-code" src="/assets/support-author.png" mode="widthFix" show-menu-by-longpress="{{true}}" bindtap="previewSupport" /><text class="note">{{t.supportHint}}</text></view>
    <view class="panel"><text class="resource-title">{{t.privacy}}</text><text class="note">{{t.privacyText}}</text><button class="text-button" bindtap="copyWebsite">{{t.website}}</button></view>
  </block>
  <view class="bottom-space"></view>
  <view class="navigation">
    <button class="nav-item {{view === 'home' || view === 'story' ? 'selected' : ''}}" data-view="home" bindtap="changeView" disabled="{{busy}}"><text class="nav-symbol">⌂</text><text>{{t.home}}</text></button>
    <button class="nav-item {{view === 'practiceHub' || view === 'practice' || view === 'papers' || view === 'courses' || view === 'review' || view === 'exam' || view === 'words' ? 'selected' : ''}}" data-view="practiceHub" bindtap="changeView" disabled="{{busy}}"><text class="nav-symbol">≡</text><text>{{t.practice}}</text></button>
    <button class="nav-item {{view === 'community' ? 'selected' : ''}}" data-view="community" bindtap="changeView" disabled="{{busy}}"><text class="nav-symbol">☷</text><text>{{t.community}}</text></button>
    <button class="nav-item {{view === 'account' || view === 'dictionary' || view === 'measurement' || view === 'resources' ? 'selected' : ''}}" data-view="account" bindtap="changeView" disabled="{{busy}}"><text class="nav-symbol">◎</text><text>{{t.account}}</text></button>
  </view>
</view>
