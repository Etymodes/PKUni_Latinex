page { background: #f7f5ef; color: #292620; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; line-height: 1.6; }
view, button, input { box-sizing: border-box; }
button { border-radius: 16rpx; font-size: 28rpx; font-weight: 500; margin: 0; padding: 20rpx 28rpx; line-height: 1.5; }
button::after { border: 0; }
button[disabled] { opacity: .62; }
text { overflow-wrap: anywhere; }
.shell { padding: 24rpx 30rpx 0; max-width: 1100rpx; margin: auto; }
.brand-row { display: flex; align-items: center; gap: 16rpx; }
.logo { width: 100rpx; height: 86rpx; }
.brand { flex: 1; }
.brand-title { display: block; color: #145489; font: 700 36rpx Georgia, "Songti SC", serif; letter-spacing: 2rpx; }
.eyebrow { display: block; font-size: 20rpx; letter-spacing: 2rpx; font-weight: 700; color: #936a34; }
.brand .eyebrow { margin-top: 6rpx; color: #447699; font-size: 16rpx; }
.locale { padding: 10rpx 18rpx; font-size: 24rpx; border: 1rpx solid #dcd7cc; background: #fffefa; }
.status { font-size: 21rpx; color: #736e62; margin: 16rpx 0 26rpx; }
.dot { color: #256f60; margin-right: 7rpx; font-size: 16rpx; }
.status-error, .status-error .dot { color: #951f36; }
.notice { background: #fff1eb; border: 1rpx solid #e9cbbb; padding: 20rpx; margin-bottom: 24rpx; font-size: 25rpx; border-radius: 12rpx; }
.muted { color: #827b6e; }
.language-picker { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: #fffcf7; border: 1rpx solid #e6e0d5; border-radius: 14rpx; padding: 20rpx 22rpx; margin-bottom: 20rpx; }
.language-picker .text-button { padding: 0; }
.panel { background: #fffefa; border: 1rpx solid #e8e1d6; border-radius: 18rpx; padding: 30rpx; margin-bottom: 24rpx; }
.hero { padding: 38rpx 32rpx; }
.hero-title { display: block; font-family: Georgia, "Songti SC", serif; font-size: 50rpx; line-height: 1.45; margin: 16rpx 0; }
.body { display: block; font-size: 28rpx; line-height: 1.8; margin: 14rpx 0; white-space: pre-wrap; }
.primary { color: #fff; background: #94233b; margin-top: 24rpx; }
.secondary { background: #f1ede4; color: #4e463a; margin-top: 24rpx; }
.text-button { color: #94233b; background: transparent; padding: 14rpx 0; font-size: 25rpx; }
.stats { display: flex; margin: 0 0 24rpx; background: #fffefa; border: 1rpx solid #e8e1d6; border-radius: 18rpx; padding: 22rpx 0; }
.stats > view { width: 25%; text-align: center; font-size: 20rpx; color: #837969; border-right: 1rpx solid #e9e2d7; }.stats > view:last-child { border: 0; }
.number { display: block; font: 700 40rpx Georgia, serif; color: #332e27; margin: 2rpx 0 8rpx; }
.fact { background: #eaf3f8; border: 1rpx solid #cddfe8; border-radius: 18rpx; padding: 28rpx; color: #23567d; }
.fact-title { display: block; margin-top: 12rpx; font: 600 35rpx Georgia, serif; line-height: 1.5; }
.note { display: block; font-size: 23rpx; line-height: 1.8; color: #867d6e; margin: 18rpx 0; }
.row-link { display: flex; justify-content: space-between; gap: 12rpx; text-align: left; margin: 22rpx 0; border: 1rpx solid #e6e0d5; background: #fffefa; }
.filters { display: flex; gap: 12rpx; margin-bottom: 22rpx; }
.chip { flex: 1; padding: 15rpx 7rpx; border: 1rpx solid #e3ddd1; background: #fffefa; font-size: 24rpx; }
.chip.chosen { color: #94233b; background: #f3e8e8; border-color: #d4b1b5; }
.search, .field { background: #fffefa; border: 1rpx solid #ded8cd; padding: 20rpx; height: 88rpx; border-radius: 12rpx; margin: 20rpx 0; }
.empty { padding: 50rpx 30rpx; color: #867b68; text-align: center; }
.question-top { display: flex; gap: 10rpx; align-items: center; justify-content: space-between; margin: -10rpx 0 18rpx; }.question-top .eyebrow { letter-spacing: 0; }
.question-title { display: block; font-size: 33rpx; font-weight: 600; line-height: 1.65; }
.target-text { display: block; font-family: Georgia, serif; font-size: 36rpx; background: #f6f2e9; padding: 22rpx; margin: 24rpx 0; white-space: pre-wrap; }
.option { display: flex; gap: 18rpx; text-align: left; background: #faf8f2; border: 1rpx solid #e3ddd1; padding: 22rpx 18rpx; margin: 16rpx 0; font-size: 27rpx; font-weight: 400; }
.option[disabled] { opacity: 1; color: #6b6355; }.option-number { color: #988c77; min-width: 24rpx; }
.option.answer-right { background: #eaf4ef; border-color: #6b9d84; color: #256f60; }.option.answer-wrong { background: #fbefee; border-color: #c78e92; color: #94233b; }
.answer-panel { border-left: 5rpx solid #c5aa73; background: #faf6ed; padding: 22rpx; margin: 26rpx 0; }.answer-title { font-weight: 700; }
.source { font-size: 21rpx; color: #8d8270; margin-top: 24rpx; }
.actions { display: flex; gap: 20rpx; }.actions button { flex: 1; }
.question-link { display: block; width: 100%; background: #fffefa; border-bottom: 1rpx solid #e4dccd; text-align: left; font-size: 26rpx; }.question-link text { display: block; }.question-link .muted { font-size: 21rpx; }
.word-panel { text-align: center; padding: 46rpx 28rpx; }.word-term { display: block; font: 600 52rpx Georgia, serif; margin: 40rpx 0 28rpx; }.word-context { display: block; font-family: Georgia, serif; font-size: 32rpx; color: #6e6250; margin: 28rpx 0; }.word-meaning { display: block; font-size: 34rpx; margin: 36rpx 0; color: #256f60; }
.section-title { display: block; font: 600 43rpx Georgia, "Songti SC", serif; margin: 30rpx 0; }.resource-title { display: block; font-size: 30rpx; font-weight: 600; }.account-email { display: block; color: #23567d; margin: 25rpx 0; font-size: 30rpx; }
.bottom-space { height: 170rpx; }.navigation { position: fixed; bottom: 0; left: 0; right: 0; display: flex; padding: 8rpx 20rpx calc(14rpx + env(safe-area-inset-bottom)); background: #fffefa; border-top: 1rpx solid #e3ddd2; z-index: 10; }
.nav-item { width: 25%; background: transparent; color: #847e71; padding: 12rpx 5rpx; border-radius: 12rpx; font-size: 22rpx; text-align: center; }.nav-item text { display: block; }.nav-symbol { font-size: 35rpx; line-height: 1.2; margin-bottom: 5rpx; font-family: Georgia, serif; }.nav-item.selected { color: #94233b; font-weight: 600; }
